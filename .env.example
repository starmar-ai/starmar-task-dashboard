# Copy this file to .env.local and fill in the two values from
# Supabase: Project Settings > API (Project URL and the anon/publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel Functions), never prefixed with VITE_: the service_role / secret key from
# Supabase Project Settings > API Keys. Used by api/team.ts for invites and revoking access.
SUPABASE_SERVICE_ROLE_KEY=
